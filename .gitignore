# ===========================================
# Nginx Security Stack - Git Ignore
# ===========================================

# Environment files (contain secrets)
.env
.env.*
!.env.example

# Logs
logs/*
!logs/.gitkeep
*.log

# SSL Certificates (sensitive)
certs/*
!certs/.gitkeep
*.pem
*.key
*.crt
*.csr

# CrowdSec data
config/crowdsec-bouncer/
crowdsec-data/

# Docker volumes data
loki-data/
grafana-data/

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Backup files
*.bak
*.backup
*.old
*.orig

# Temp files
*.tmp
*.temp
